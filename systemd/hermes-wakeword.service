[Unit]
Description=Okay Hermes native wakeword activation listener
Wants=pipewire.service pipewire-pulse.service wireplumber.service
After=pipewire.service pipewire-pulse.service wireplumber.service

[Service]
Type=simple
ExecStart=%h/.hermes/wakeword/bin/okay-hermes-wake-listener --hermes-home %h/.hermes --threshold 0.6973556280136108 --consecutive 1 --inference-interval-ms 500
WorkingDirectory=%h
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=HERMES_HOME=%h/.hermes
Environment=HERMES_REPO=%h/.hermes/hermes-agent
Environment=PYTHONPATH=%h/.hermes/hermes-agent
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=PULSE_SERVER=unix:/run/user/%U/pulse/native

[Install]
WantedBy=default.target
